{
  "name": "stickify21",
  "version": "1.0.0",
  "description": "STICKIFY 21 — Minimalist Sticker & Bookmark Studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./styles.css -o ./dist/styles.css --minify",
    "watch:css": "tailwindcss -i ./styles.css -o ./dist/styles.css --watch",
    "pretest": "npm run build:css",
    "test": "playwright test",
    "serve": "npm run build:css && python scripts/server.py 3000",
    "share": "npm run build:css && npx cloudflared tunnel --url http://127.0.0.1:3000"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "serve": "^14.2.1",
    "tailwindcss": "^3.4.1"
  }
}
